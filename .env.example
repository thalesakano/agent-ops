# Copy to .env.local. Never use NEXT_PUBLIC_ for these values.
# Generate a DIFFERENT random value for each secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_OPS_PASSWORD=
AGENT_OPS_SESSION_SECRET=
# Exact browser origin. Use HTTPS in production; match the port used locally.
AGENT_OPS_ORIGIN=http://localhost:3000

# OpenClaw: configure one of TOKEN / PASSWORD, never both.
OPENCLAW_GATEWAY_URL=
OPENCLAW_TOKEN=
OPENCLAW_PASSWORD=
# Created automatically; persist this file across deploys and protect its permissions.
OPENCLAW_DEVICE_FILE=.data/openclaw-device.json

# Hermes dashboard API (not a model API or a messaging gateway).
HERMES_DASHBOARD_URL=
# password | cookie | local (local requires a loopback URL)
HERMES_AUTH_MODE=password
HERMES_AUTH_PROVIDER=basic
HERMES_USERNAME=
HERMES_PASSWORD=
# For OAuth/provider sessions, use the Cookie request-header value, not Set-Cookie.
# Expiring cookies must be renewed. Keep this value only on the server.
HERMES_SESSION_COOKIE=
